    {
      "id": "junction_c49825c1-daee-479f-bd35-93005444ee55",
      "metadataId": "junction",
      "x": 652.0553431593648,
      "y": 236.94720891602043,
      "properties": {
        "color": "#000000"
      }
    },
    {
      "id": "custom_chip_1794831058441_o5kbdc20j",
      "metadataId": "custom-chip",
      "x": -291.194240888861,
      "y": 83.49542299292474,
      "properties": {
        "chipName": "Sensor_Array",
        "sourceC": "#include \"velxio-chip.h\"\n\n/*\n * 3x VL53L0X Time-of-Flight I2C Array for Velxio\n * - Default 7-bit I2C Address: 0x29 (programmable via reg 0x8A)\n * - Enable Pins: XSHUT1, XSHUT2, XSHUT3 (Active HIGH; pulling LOW resets sensor to 0x29)\n * - Handles ST/Pololu/Adafruit paged SPAD boot sequence (0x83 poll on page 0x07 & 0x92 read)\n */\n\n#define VL53L0X_DEFAULT_ADDR 0x29\n#define PI_VAL               3.14159265358979323846\n#define TWO_PI_VAL           6.28318530717958647692\n\ntypedef struct {\n  vx_pin   pin_xshut;\n  uint8_t  i2c_addr;\n  uint8_t  regs[256];\n  uint8_t  page;\n  uint16_t dist_mm;\n  double   phase_offset;\n  int      was_enabled;\n} vl53_unit_t;\n\ntypedef struct {\n  vx_pin      pin_vcc;\n  vx_pin      pin_gnd;\n  vx_pin      pin_sda;\n  vx_pin      pin_scl;\n  vl53_unit_t units[3];\n\n  int      active_unit;\n  uint8_t  reg_ptr;\n  int      expect_reg_addr;\n\n  vx_attr  attr_freq_hz;\n  vx_attr  attr_noise_mm;\n  uint32_t lfsr;\n  vx_timer sim_timer;\n} vl53_array_t;\n\nstatic vl53_array_t S;\n\nstatic double fast_sin(double rad) {\n  while (rad > PI_VAL)  rad -= TWO_PI_VAL;\n  while (rad < -PI_VAL) rad += TWO_PI_VAL;\n  double x2 = rad * rad;\n  return rad * (1.0 - x2 * (1.0 / 6.0 - x2 * (1.0 / 120.0 - x2 * (1.0 / 5040.0))));\n}\n\nstatic double rand_bipolar(void) {\n  uint32_t x = S.lfsr;\n  x ^= x << 13;\n  x ^= x >> 17;\n  x ^= x << 5;\n  S.lfsr = x;\n  return ((double)(x & 0xFFFFU) / 32768.0) - 1.0;\n}\n\nstatic void reset_unit_registers(vl53_unit_t *u) {\n  for (int i = 0; i < 256; i++) {\n    u->regs[i] = 0x00;\n  }\n  u->i2c_addr   = VL53L0X_DEFAULT_ADDR;\n  u->page       = 0x00;\n\n  /* Identification & Revision Registers */\n  u->regs[0xC0] = 0xEE; /* WHO_AM_I Model ID */\n  u->regs[0xC1] = 0xAA;\n  u->regs[0xC2] = 0x10; /* Revision ID */\n  u->regs[0x51] = 0x00;\n  u->regs[0x61] = 0x00;\n\n  /* Boot, MSRC, Sequence & I2C Config Defaults */\n  u->regs[0x80] = 0x01;\n  u->regs[0x83] = 0x01; /* SPAD strobe ready */\n  u->regs[0x84] = 0x00;\n  u->regs[0x88] = 0x00;\n  u->regs[0x89] = 0x01;\n  u->regs[0x8A] = VL53L0X_DEFAULT_ADDR;\n  u->regs[0x91] = 0x3C; /* Stop variable */\n  u->regs[0x92] = 0x06; /* SPAD count = 6, aperture = 0 */\n  u->regs[0x01] = 0xFF; /* SYSTEM_SEQUENCE_CONFIG */\n  u->regs[0x04] = 0x01;\n  u->regs[0x60] = 0x00;\n\n  /* Reference SPAD Map (6 valid SPADs enabled) */\n  u->regs[0xB0] = 0x3F;\n  u->regs[0xB1] = 0x00;\n  u->regs[0xB2] = 0x00;\n  u->regs[0xB3] = 0x00;\n  u->regs[0xB4] = 0x00;\n  u->regs[0xB5] = 0x00;\n\n  /* Measurement & Interrupt Ready Status */\n  u->regs[0x00] = 0x00; /* SYSRANGE_START bit 0 = 0 (idle/ready) */\n  u->regs[0x13] = 0x07; /* RESULT_INTERRUPT_STATUS: non-zero (ready) */\n  u->regs[0x14] = 0x01; /* Bit 0 = 1 (boot/data ready), low nibble/range status valid */\n}\n\nstatic void update_unit_distance_regs(vl53_unit_t *u, uint16_t mm) {\n  u->dist_mm = mm;\n  u->regs[0x00] = 0x00; /* Bit 0 cleared = measurement complete */\n  u->regs[0x13] = 0x07; /* Interrupt status: sample ready */\n  /*\n   * Register 0x14 (RESULT_RANGE_STATUS):\n   * - Bit 0 = 1 (data ready in some minimal drivers)\n   * - Low nibble = 0x00 if driver checks (reg0x14 & 0x0F) == 0\n   */\n  u->regs[0x14] = 0x00;\n  /* 12-byte result block at 0x14..0x1F: bytes [10..11] (0x1E, 0x1F) = range in mm */\n  u->regs[0x1E] = (uint8_t)((mm >> 8) & 0xFF);\n  u->regs[0x1F] = (uint8_t)(mm & 0xFF);\n}\n\nstatic void on_tick(void *user_data) {\n  (void)user_data;\n\n  double t_sec    = (double)vx_sim_now_nanos() * 1e-9;\n  double freq_hz  = vx_attr_read(S.attr_freq_hz);\n  double noise_mm = vx_attr_read(S.attr_noise_mm);\n  if (freq_hz < 0.05) freq_hz = 0.5;\n  if (noise_mm < 0.0) noise_mm = 0.0;\n\n  for (int i = 0; i < 3; i++) {\n    vl53_unit_t *u = &S.units[i];\n    int en = (vx_pin_read(u->pin_xshut) == VX_HIGH);\n\n    if (!en) {\n      if (u->was_enabled) {\n        reset_unit_registers(u);\n        u->was_enabled = 0;\n      }\n      continue;\n    }\n    u->was_enabled = 1;\n\n    double angle = TWO_PI_VAL * freq_hz * t_sec + u->phase_offset;\n    double raw_mm = 500.0 + 300.0 * fast_sin(angle) + (noise_mm * rand_bipolar());\n    if (raw_mm < 200.0) raw_mm = 200.0;\n    if (raw_mm > 800.0) raw_mm = 800.0;\n\n    update_unit_distance_regs(u, (uint16_t)(raw_mm + 0.5));\n  }\n}\n\nstatic bool on_i2c_connect(void *user_data, uint8_t addr, bool is_read) {\n  (void)user_data;\n  (void)is_read;\n\n  on_tick(0);\n\n  S.active_unit = -1;\n  for (int i = 0; i < 3; i++) {\n    if (vx_pin_read(S.units[i].pin_xshut) == VX_HIGH && S.units[i].i2c_addr == addr) {\n      S.active_unit = i;\n      break;\n    }\n  }\n\n  if (S.active_unit < 0) {\n    return false;\n  }\n\n  S.expect_reg_addr = 1;\n  return true;\n}\n\nstatic uint8_t on_i2c_read(void *user_data) {\n  (void)user_data;\n  if (S.active_unit < 0) {\n    return 0xFF;\n  }\n  vl53_unit_t *u = &S.units[S.active_unit];\n  uint8_t reg = S.reg_ptr;\n  uint8_t val = u->regs[reg];\n\n  /* Always satisfy SPAD info poll (0x83 != 0 on ANY page) and SPAD count (0x92) */\n  if (reg == 0x83) {\n    val = 0x01;\n  } else if (reg == 0x92) {\n    val = 0x06; /* 6 SPADs, type 0 */\n  } else if (reg == 0x91 && val == 0x00) {\n    val = 0x3C; /* Stop variable */\n  }\n\n  S.reg_ptr = (uint8_t)((S.reg_ptr + 1) & 0xFF);\n  return val;\n}\n\nstatic bool on_i2c_write(void *user_data, uint8_t byte) {\n  (void)user_data;\n  if (S.active_unit < 0) {\n    return false;\n  }\n  vl53_unit_t *u = &S.units[S.active_unit];\n\n  if (S.expect_reg_addr) {\n    S.reg_ptr = byte;\n    S.expect_reg_addr = 0;\n    return true;\n  }\n\n  uint8_t reg = S.reg_ptr;\n  u->regs[reg] = byte;\n\n  if (reg == 0xFF) {\n    u->page = byte;\n  }\n  if (reg == 0x8A) {\n    u->i2c_addr = byte & 0x7F;\n  }\n  /* When firmware writes 0x83 = 0x00 to start SPAD strobe, immediately set 0x83 = 0x01 ready */\n  if (reg == 0x83 && byte == 0x00) {\n    u->regs[0x83] = 0x01;\n  }\n  /* When firmware triggers SYSRANGE_START / VHV / Phase cal (0x00), mark finished immediately */\n  if (reg == 0x00) {\n    u->regs[0x00] = 0x00; /* Clear start bit 0 */\n    u->regs[0x13] = 0x07; /* Set interrupt ready bits */\n    u->regs[0x14] = 0x00; /* Valid status */\n  }\n  /* Keep interrupt status ready after clear (0x0B) so next single-shot/calibration step succeeds */\n  if (reg == 0x0B) {\n    u->regs[0x13] = 0x07;\n  }\n\n  S.reg_ptr = (uint8_t)((S.reg_ptr + 1) & 0xFF);\n  return true;\n}\n\nstatic void on_i2c_stop(void *user_data) {\n  (void)user_data;\n  S.active_unit = -1;\n}\n\nvoid chip_setup(void) {\n  S.lfsr        = 0xACE12345U;\n  S.active_unit = -1;\n\n  S.pin_vcc = vx_pin_register(\"VCC\", VX_INPUT_PULLUP);\n  S.pin_gnd = vx_pin_register(\"GND\", VX_INPUT_PULLDOWN);\n  S.pin_sda = vx_pin_register(\"SDA\", VX_INPUT_PULLUP);\n  S.pin_scl = vx_pin_register(\"SCL\", VX_INPUT_PULLUP);\n\n  S.units[0].pin_xshut = vx_pin_register(\"XSHUT1\", VX_INPUT_PULLUP);\n  S.units[1].pin_xshut = vx_pin_register(\"XSHUT2\", VX_INPUT_PULLUP);\n  S.units[2].pin_xshut = vx_pin_register(\"XSHUT3\", VX_INPUT_PULLUP);\n\n  for (int i = 0; i < 3; i++) {\n    reset_unit_registers(&S.units[i]);\n    S.units[i].phase_offset = (double)i * (TWO_PI_VAL / 3.0);\n    S.units[i].was_enabled  = 1;\n  }\n\n  S.attr_freq_hz  = vx_attr_register(\"wave_freq_hz\", 0.5);\n  S.attr_noise_mm = vx_attr_register(\"noise_mm\",     15.0);\n\n  const vx_i2c_config i2c_cfg = {\n    .address    = VL53L0X_DEFAULT_ADDR,\n    .scl        = S.pin_scl,\n    .sda        = S.pin_sda,\n    .on_connect = on_i2c_connect,\n    .on_read    = on_i2c_read,\n    .on_write   = on_i2c_write,\n    .on_stop    = on_i2c_stop,\n    .user_data  = &S,\n  };\n  vx_i2c_attach(&i2c_cfg);\n\n  S.sim_timer = vx_timer_create(on_tick, 0);\n  vx_timer_start(S.sim_timer, 20000000ULL, true);\n\n  on_tick(0);\n  vx_log(\"3x VL53L0X ToF Array ready on 0x29 (XSHUT1..3)\");\n}",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"VL53L0X_3x_Array\",\n  \"author\": \"Custom\",\n  \"description\": \"3x VL53L0X ToF I2C Laser Ranging Array with XSHUT1..3 enable pins and 0.2m-0.8m sine-wave distance simulation.\",\n  \"pins\": [\n    \"VCC\",\n    \"GND\",\n    \"SDA\",\n    \"SCL\",\n    \"XSHUT1\",\n    \"XSHUT2\",\n    \"XSHUT3\"\n  ],\n  \"attributes\": [\n    {\n      \"name\": \"wave_freq_hz\",\n      \"label\": \"Sine Wave Frequency (Hz)\",\n      \"type\": \"float\",\n      \"default\": 0.5,\n      \"min\": 0.1,\n      \"max\": 5.0,\n      \"step\": 0.1\n    },\n    {\n      \"name\": \"noise_mm\",\n      \"label\": \"Random Jitter Amplitude (mm)\",\n      \"type\": \"float\",\n      \"default\": 15.0,\n      \"min\": 0.0,\n      \"max\": 50.0,\n      \"step\": 1.0\n    }\n  ],\n  \"controls\": [\n    {\n      \"id\": \"wave_freq_hz\",\n      \"label\": \"Sine Wave Speed\",\n      \"type\": \"range\",\n      \"min\": 0.1,\n      \"max\": 5.0,\n      \"step\": 0.1,\n      \"unit\": \"Hz\"\n    },\n    {\n      \"id\": \"noise_mm\",\n      \"label\": \"Random Sensor Jitter\",\n      \"type\": \"range\",\n      \"min\": 0.0,\n      \"max\": 50.0,\n      \"step\": 1.0,\n      \"unit\": \"mm\"\n    }\n  ]\n}",
