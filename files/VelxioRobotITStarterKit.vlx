    {
      "id": "custom_chip_1794828793650_zg2voopv9",
      "metadataId": "custom-chip",
      "x": 683.356992326679,
      "y": 115.08183565282621,
      "properties": {
        "chipName": "DC_Motor_with_Encoder 1",
        "sourceC": "#include \"velxio-chip.h\"\n\n#define RATED_VOLTAGE_V    12.0\n#define RATED_NO_LOAD_RPM  200.0\n\n/* 2 ms (500 Hz) tick period */\n#define SAMPLE_PERIOD_NS   2000000ULL\n#define DT_SEC             0.002000\n\ntypedef struct {\n  vx_pin pin_m1;\n  vx_pin pin_gnd;\n  vx_pin pin_enca;\n  vx_pin pin_encb;\n  vx_pin pin_vcc;\n  vx_pin pin_m2;\n\n  vx_attr attr_supply_voltage;\n  vx_attr attr_mechanical_load;\n  vx_attr attr_gear_ratio;\n\n  double   filtered_duty;\n  double   phase_accumulator;\n  int      last_quad_state;\n  vx_timer sim_timer;\n} chip_state_t;\n\nstatic chip_state_t S;\n\nstatic const int QUAD_TABLE_A[4] = { VX_HIGH, VX_HIGH, VX_LOW,  VX_LOW };\nstatic const int QUAD_TABLE_B[4] = { VX_LOW,  VX_HIGH, VX_HIGH, VX_LOW };\n\n/*\n * M1/M2 haengen am L293D, und der wird in Velxio nur im SPICE-Solver\n * simuliert. Auf ESP32-Boards laeuft dieser Chip im QEMU-Worker im Backend:\n * vx_pin_read() kennt dort nur Board-GPIOs und Chip-zu-Chip-Netze, ein Pin an\n * einem SPICE-Netz liest immer LOW -> Motor steht -> Encoder zaehlt nie.\n * Die vom Solver berechnete Spannung kommt aber im Worker an und ist ueber\n * vx_pin_read_analog() lesbar.\n */\n#define DRIVE_THRESHOLD_V  1.0\n\n/* Mechanische Zeitkonstante des Motors (Traegheit). Glaettet die 20-Hz-\n * Software-PWM, sodass Teil-Duty (z.B. 60 %) eine ruhige Drehzahl ergibt. */\n#define MECH_TAU_SEC       0.060\n#define MECH_ALPHA         (DT_SEC / (MECH_TAU_SEC + DT_SEC))\n\nstatic int terminal_high(vx_pin p) {\n  return (vx_pin_read(p) != VX_LOW) ||\n         (vx_pin_read_analog(p) > DRIVE_THRESHOLD_V);\n}\n\nstatic double abs_val(double x) {\n  return (x < 0.0) ? -x : x;\n}\n\nstatic int floor_to_int(double x) {\n  int i = (int)x;\n  return (x < (double)i) ? (i - 1) : i;\n}\n\nstatic void on_tick(void *user_data) {\n  (void)user_data;\n\n  int m1 = terminal_high(S.pin_m1);\n  int m2 = terminal_high(S.pin_m2);\n\n  double instant_drive = 0.0;\n  if (m1 && !m2) {\n    instant_drive = 1.0;\n  } else if (!m1 && m2) {\n    instant_drive = -1.0;\n  }\n\n  S.filtered_duty += MECH_ALPHA * (instant_drive - S.filtered_duty);\n\n  double v_supply   = vx_attr_read(S.attr_supply_voltage);\n  double load_pct   = vx_attr_read(S.attr_mechanical_load);\n  double gear_ratio = vx_attr_read(S.attr_gear_ratio);\n  if (v_supply <= 0.1)  v_supply   = 12.0;\n  if (gear_ratio < 1.0) gear_ratio = 150.0;\n\n  double duty_mag = abs_val(S.filtered_duty);\n  double shaft_rpm = 0.0;\n\n  if (duty_mag >= 0.02) {\n    double voltage_factor = (duty_mag * v_supply) / RATED_VOLTAGE_V;\n    if (load_pct > 100.0) load_pct = 100.0;\n    if (load_pct < 0.0)   load_pct = 0.0;\n    double load_factor = 1.0 - (load_pct * 0.01);\n\n    double dir = (S.filtered_duty >= 0.0) ? 1.0 : -1.0;\n    double ratio_scale = 150.0 / gear_ratio;\n    shaft_rpm = dir * RATED_NO_LOAD_RPM * voltage_factor * load_factor * ratio_scale;\n  }\n\n  /* 40 quadrature states per revolution */\n  double states_per_rev = 40.0;\n  double rps = shaft_rpm / 60.0;\n  S.phase_accumulator += rps * states_per_rev * DT_SEC;\n\n  int quad_idx = floor_to_int(S.phase_accumulator) & 3;\n  S.last_quad_state = quad_idx;\n\n  /* Unconditionally drive ENCA and ENCB every tick so QEMU pin bridge stays synced */\n  vx_pin_write(S.pin_enca, QUAD_TABLE_A[quad_idx]);\n  vx_pin_write(S.pin_encb, QUAD_TABLE_B[quad_idx]);\n}\n\nvoid chip_setup(void) {\n  S.filtered_duty     = 0.0;\n  S.phase_accumulator = 0.0;\n  S.last_quad_state   = 0;\n\n  S.pin_m1   = vx_pin_register(\"M1\",   VX_INPUT);\n  S.pin_gnd  = vx_pin_register(\"GND\",  VX_INPUT_PULLDOWN);\n  S.pin_enca = vx_pin_register(\"ENCA\", VX_OUTPUT_HIGH);\n  S.pin_encb = vx_pin_register(\"ENCB\", VX_OUTPUT_LOW);\n  S.pin_vcc  = vx_pin_register(\"VCC\",  VX_INPUT_PULLUP);\n  S.pin_m2   = vx_pin_register(\"M2\",   VX_INPUT);\n\n  S.attr_supply_voltage  = vx_attr_register(\"supply_voltage\",  12.0);\n  S.attr_mechanical_load = vx_attr_register(\"mechanical_load\", 0.0);\n  S.attr_gear_ratio      = vx_attr_register(\"gear_ratio\",      150.0);\n\n  S.sim_timer = vx_timer_create(on_tick, 0);\n  vx_timer_start(S.sim_timer, SAMPLE_PERIOD_NS, true);\n\n  on_tick(0);\n  vx_log(\"Waveshare N20 motor block ready\");\n}",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"DC_Motor_with_Encoder\",\n  \"author\": \"Custom\",\n  \"description\": \"Waveshare DCGM-N20-12V-EN-200RPM (1:150 gear ratio, 7PPR Hall / 1050PPR output shaft) with ZH1.5-6PIN L-shaped connector.\",\n  \"pins\": [\n    \"M1\",\n    \"GND\",\n    \"ENCA\",\n    \"ENCB\",\n    \"VCC\",\n    \"M2\"\n  ],\n  \"attributes\": [\n    {\n      \"name\": \"supply_voltage\",\n      \"label\": \"Motor Supply Voltage (V)\",\n      \"type\": \"float\",\n      \"default\": 12,\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.5\n    },\n    {\n      \"name\": \"mechanical_load\",\n      \"label\": \"Mechanical Shaft Load (%)\",\n      \"type\": \"float\",\n      \"default\": 0,\n      \"min\": 0,\n      \"max\": 100,\n      \"step\": 5\n    },\n    {\n      \"name\": \"gear_ratio\",\n      \"label\": \"Gear Reduction Ratio (:1)\",\n      \"type\": \"float\",\n      \"default\": 150,\n      \"min\": 10,\n      \"max\": 300,\n      \"step\": 10\n    }\n  ],\n  \"controls\": [\n    {\n      \"id\": \"supply_voltage\",\n      \"label\": \"Motor Supply Voltage\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.5,\n      \"unit\": \"V\"\n    },\n    {\n      \"id\": \"mechanical_load\",\n      \"label\": \"Mechanical Shaft Load\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 100,\n      \"step\": 5,\n      \"unit\": \"%\"\n    },\n    {\n      \"id\": \"gear_ratio\",\n      \"label\": \"Gear Reduction Ratio\",\n      \"type\": \"range\",\n      \"min\": 10,\n      \"max\": 300,\n      \"step\": 10,\n      \"unit\": \":1\"\n    }\n  ]\n}",
        "wasmBase64": "",
