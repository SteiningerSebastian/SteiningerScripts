        "chipName": "Status LED",
        "sourceC": "#include \"velxio-chip.h\"\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/*\n * Status LED -- networked custom chip.\n *\n * Watches anode A (GPIO 2) and mirrors transitions immediately + 1 s heartbeat\n * over HTTP using vx_net_request / vx_net_poll.\n */\n\n#define DEFAULT_URL      \"http://127.0.0.1:8765/api/led\"\n#define TICK_PERIOD_NS   50000000ULL\n#define HEARTBEAT_NS     1000000000ULL\n#define MIN_BACKOFF_NS   100000000ULL\n#define MAX_BACKOFF_NS   2000000000ULL\n\ntypedef struct {\n  vx_pin   pin_a;\n  vx_pin   pin_c;\n  vx_attr  attr_url;\n  vx_attr  attr_rate;\n  vx_timer net_timer;\n\n  int      lit;\n  int      dirty;\n  int      sent_lit;\n  int      inflight_lit;\n  int      online;\n  int      link_ok;\n  int      req_in_flight;\n  int      logged_offline;\n  uint64_t next_net_ns;\n  uint64_t backoff_ns;\n  char     url[256];\n  char     reply[128];\n} chip_state_t;\n\nstatic chip_state_t S;\n\nstatic const char *url_of(void) {\n  uint32_t n = vx_attr_string_read(S.attr_url, S.url, (uint32_t)sizeof(S.url));\n  return (n > 0 && S.url[0]) ? S.url : DEFAULT_URL;\n}\n\nstatic void on_change(void *user_data, vx_pin pin, int value) {\n  (void)user_data;\n  (void)pin;\n  int next = (value != 0) ? 1 : 0;\n  if (next == S.lit) return;\n  S.lit   = next;\n  S.dirty = 1;\n  vx_log(next ? \"Status LED: ON\" : \"Status LED: OFF\");\n}\n\nstatic void handle_net_error(uint64_t now) {\n  if (S.link_ok || !S.logged_offline) {\n    vx_log(\"Status LED: simulator unreachable (offline)\");\n    S.logged_offline = 1;\n  }\n  S.link_ok = 0;\n  S.next_net_ns = now + S.backoff_ns;\n  if (S.backoff_ns < MAX_BACKOFF_NS) {\n    S.backoff_ns *= 2ULL;\n    if (S.backoff_ns > MAX_BACKOFF_NS) S.backoff_ns = MAX_BACKOFF_NS;\n  }\n}\n\nstatic void on_tick(void *user_data) {\n  (void)user_data;\n  if (!S.online) return;\n\n  uint64_t now = vx_sim_now_nanos();\n\n  if (S.req_in_flight) {\n    int32_t n = vx_net_poll();\n    if (n == VX_NET_BUSY) return;\n    S.req_in_flight = 0;\n    if (n < 0) {\n      handle_net_error(now);\n      return;\n    }\n\n    int32_t got = vx_net_resp_read(0, S.reply, (uint32_t)(sizeof(S.reply) - 1));\n    S.reply[got > 0 ? got : 0] = '\\0';\n    S.link_ok = (vx_net_status() == 200);\n    if (S.link_ok) {\n      S.logged_offline = 0;\n      S.backoff_ns = MIN_BACKOFF_NS;\n      S.sent_lit = S.inflight_lit;\n      if (S.lit == S.sent_lit) {\n        S.dirty = 0;\n      }\n    }\n\n    double rate = vx_attr_read(S.attr_rate);\n    uint64_t interval_ns = HEARTBEAT_NS;\n    if (rate >= 1.0 && rate <= 100.0) {\n      uint64_t r_ns = (uint64_t)(1e9 / rate);\n      if (r_ns > interval_ns) interval_ns = r_ns;\n    }\n    S.next_net_ns = now + interval_ns;\n    return;\n  }\n\n  if (S.link_ok == 0 && now < S.next_net_ns) return;\n  if (!S.dirty && now < S.next_net_ns) return;\n\n  S.inflight_lit = S.lit;\n  char body[96];\n  snprintf(body, sizeof(body), \"{\\\"v\\\":1,\\\"led\\\":%d,\\\"t_ns\\\":%llu}\",\n           S.inflight_lit, (unsigned long long)now);\n\n  int32_t rc = vx_net_request(\"POST\", url_of(), \"text/plain\", body, (uint32_t)strlen(body));\n  if (rc == 0) {\n    S.req_in_flight = 1;\n  } else if (rc != VX_NET_BUSY) {\n    handle_net_error(now);\n  }\n}\n\nvoid chip_setup(void) {\n  memset(&S, 0, sizeof(S));\n  S.pin_a = vx_pin_register(\"A\", VX_INPUT);\n  S.pin_c = vx_pin_register(\"C\", VX_INPUT);\n  S.attr_url  = vx_attr_register_string(\"url\",  DEFAULT_URL);\n  S.attr_rate = vx_attr_register(\"rate\", 5.0);\n\n  S.lit         = (vx_pin_read(S.pin_a) != 0) ? 1 : 0;\n  S.dirty       = 1;\n  S.sent_lit    = -1;\n  S.online      = (vx_net_available() != 0);\n  S.next_net_ns = TICK_PERIOD_NS;\n  S.backoff_ns  = MIN_BACKOFF_NS;\n\n  vx_pin_watch(S.pin_a, VX_EDGE_BOTH, on_change, 0);\n\n  if (S.online) {\n    S.net_timer = vx_timer_create(on_tick, 0);\n    vx_timer_start(S.net_timer, TICK_PERIOD_NS, true);\n  }\n  vx_log(S.online ? \"Status LED networked model ready\" : \"Status LED offline model ready\");\n}\n",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"Status_LED\",\n  \"author\": \"Custom\",\n  \"description\": \"Status LED (A = anode, C = cathode). Mirrors LED state to the 2D simulator over HTTP when online.\",\n  \"pins\": [\n    { \"name\": \"A\", \"x\": 4, \"y\": 28 },\n    { \"name\": \"C\", \"x\": 76, \"y\": 28 },\n    { \"name\": \"\", \"x\": 76, \"y\": 52 }\n  ],\n  \"attributes\": [\n    {\n      \"name\": \"url\",\n      \"label\": \"Simulator URL\",\n      \"type\": \"string\",\n      \"default\": \"http://127.0.0.1:8765/api/led\"\n    },\n    {\n      \"name\": \"rate\",\n      \"label\": \"Sim Polls / s\",\n      \"type\": \"int\",\n      \"default\": 5,\n      \"min\": 1,\n      \"max\": 100\n    }\n  ],\n  \"controls\": []\n}\n",
        "wasmBase64": "",
        "romBytes": "",
        "programFile": "",
        "programTarget": "",
        "image": "data:image/svg+xml;base64,",
        "sourceHash": "5f61bf2e"
      }
