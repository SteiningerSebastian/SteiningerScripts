    {
      "id": "custom_chip_boot_button_1794850000002",
      "metadataId": "custom-chip",
      "x": 194,
      "y": 169,
      "properties": {
        "chipName": "Boot Button",
        "sourceC": "#include \"velxio-chip.h\"\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/*\n * BOOT button -- networked custom chip.\n *\n * Replaces the built-in 6 mm push-button between GPIO 0 and GND.\n * Uses 40 ms (25 Hz) tick and vx_net_request/vx_net_poll at 8 Hz default.\n */\n\n#define DEFAULT_URL      \"http://127.0.0.1:8765/api/button\"\n#define POLL_PERIOD_NS   40000000ULL\n#define MIN_BACKOFF_NS   100000000ULL\n#define MAX_BACKOFF_NS   2000000000ULL\n\ntypedef struct {\n  vx_pin   pin_sig;\n  vx_pin   pin_gnd;\n  vx_attr  attr_pressed;\n  vx_attr  attr_url;\n  vx_attr  attr_rate;\n  int      pressed;\n  int      net_pressed;\n  int      online;\n  int      link_ok;\n  int      req_in_flight;\n  int      logged_offline;\n  uint64_t next_net_ns;\n  uint64_t backoff_ns;\n  char     url[256];\n  char     reply[128];\n  vx_timer poll_timer;\n} chip_state_t;\n\nstatic chip_state_t S;\n\nstatic const char *url_of(void) {\n  uint32_t n = vx_attr_string_read(S.attr_url, S.url, (uint32_t)sizeof(S.url));\n  return (n > 0 && S.url[0]) ? S.url : DEFAULT_URL;\n}\n\nstatic int json_long(const char *js, const char *key, long *out) {\n  char pat[48];\n  snprintf(pat, sizeof(pat), \"\\\"%s\\\"\", key);\n  const char *p = strstr(js, pat);\n  if (!p) return 0;\n  p = strchr(p + strlen(pat), ':');\n  if (!p) return 0;\n  char *endp = NULL;\n  long val = strtol(p + 1, &endp, 10);\n  if (endp == p + 1) return 0;\n  *out = val;\n  return 1;\n}\n\nstatic void apply(int pressed) {\n  S.pressed = pressed;\n  if (pressed) {\n    vx_pin_set_mode(S.pin_sig, VX_OUTPUT_LOW);\n    vx_log(\"BOOT button: pressed\");\n  } else {\n    vx_pin_set_mode(S.pin_sig, VX_INPUT);\n    vx_log(\"BOOT button: released\");\n  }\n}\n\nstatic void handle_net_error(uint64_t now) {\n  if (S.link_ok || !S.logged_offline) {\n    vx_log(\"BOOT button: simulator unreachable (attribute-only mode)\");\n    S.logged_offline = 1;\n  }\n  S.link_ok = 0;\n  S.net_pressed = 0;\n  S.next_net_ns = now + S.backoff_ns;\n  if (S.backoff_ns < MAX_BACKOFF_NS) {\n    S.backoff_ns *= 2ULL;\n    if (S.backoff_ns > MAX_BACKOFF_NS) S.backoff_ns = MAX_BACKOFF_NS;\n  }\n}\n\nstatic void step_network(int attr_pressed) {\n  if (!S.online) return;\n  uint64_t now = vx_sim_now_nanos();\n\n  if (S.req_in_flight) {\n    int32_t n = vx_net_poll();\n    if (n == VX_NET_BUSY) return;\n    S.req_in_flight = 0;\n    if (n < 0) {\n      handle_net_error(now);\n      return;\n    }\n\n    int32_t got = vx_net_resp_read(0, S.reply, (uint32_t)(sizeof(S.reply) - 1));\n    S.reply[got > 0 ? got : 0] = '\\0';\n    S.link_ok = (vx_net_status() == 200);\n    if (S.link_ok) {\n      S.logged_offline = 0;\n      S.backoff_ns = MIN_BACKOFF_NS;\n      long p = 0;\n      if (json_long(S.reply, \"pressed\", &p)) {\n        S.net_pressed = (p != 0) ? 1 : 0;\n      }\n    } else {\n      S.net_pressed = 0;\n    }\n\n    double rate = vx_attr_read(S.attr_rate);\n    if (rate < 1.0) rate = 8.0;\n    if (rate > 100.0) rate = 100.0;\n    S.next_net_ns = now + (uint64_t)(1e9 / rate);\n    return;\n  }\n\n  if (now < S.next_net_ns) return;\n\n  char body[96];\n  snprintf(body, sizeof(body), \"{\\\"v\\\":1,\\\"attr_pressed\\\":%d,\\\"t_ns\\\":%llu}\",\n           attr_pressed, (unsigned long long)now);\n\n  int32_t rc = vx_net_request(\"POST\", url_of(), \"text/plain\", body, (uint32_t)strlen(body));\n  if (rc == 0) {\n    S.req_in_flight = 1;\n  } else if (rc != VX_NET_BUSY) {\n    handle_net_error(now);\n  }\n}\n\nstatic void on_poll(void *user_data) {\n  (void)user_data;\n  int attr_pressed = (vx_attr_read(S.attr_pressed) >= 0.5) ? 1 : 0;\n  step_network(attr_pressed);\n  int eff_pressed = (attr_pressed || (S.link_ok && S.net_pressed)) ? 1 : 0;\n  if (eff_pressed != S.pressed) {\n    apply(eff_pressed);\n  }\n}\n\nvoid chip_setup(void) {\n  memset(&S, 0, sizeof(S));\n  S.pin_sig      = vx_pin_register(\"SIG\", VX_INPUT);\n  S.pin_gnd      = vx_pin_register(\"GND\", VX_INPUT);\n  S.attr_pressed = vx_attr_register(\"pressed\", 0.0);\n  S.attr_url     = vx_attr_register_string(\"url\", DEFAULT_URL);\n  S.attr_rate    = vx_attr_register(\"rate\", 8.0);\n\n  S.online      = (vx_net_available() != 0);\n  S.next_net_ns = POLL_PERIOD_NS;\n  S.backoff_ns  = MIN_BACKOFF_NS;\n\n  S.poll_timer = vx_timer_create(on_poll, 0);\n  vx_timer_start(S.poll_timer, POLL_PERIOD_NS, true);\n\n  vx_log(S.online ? \"BOOT button networked model ready\" : \"BOOT button offline model ready\");\n}\n",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"Boot_Button\",\n  \"author\": \"Custom\",\n  \"description\": \"Template push-button (SIG to GPIO, GND to ground). Set 'pressed' to 1 to pull SIG low.\",\n  \"pins\": [\n    { \"name\": \"SIG\", \"x\": 4, \"y\": 28 },\n    { \"name\": \"GND\", \"x\": 83, \"y\": 28 },\n    { \"name\": \"\", \"x\": 83, \"y\": 52 }\n  ],\n  \"pulls\": {\n    \"SIG\": \"up\"\n  },\n  \"attributes\": [\n    {\n      \"name\": \"pressed\",\n      \"label\": \"Pressed (0 = released, 1 = pressed)\",\n      \"type\": \"int\",\n      \"default\": 0,\n      \"min\": 0,\n      \"max\": 1,\n      \"step\": 1\n    },\n    {\n      \"name\": \"url\",\n      \"label\": \"Simulator URL\",\n      \"type\": \"string\",\n      \"default\": \"http://127.0.0.1:8765/api/button\"\n    },\n    {\n      \"name\": \"rate\",\n      \"label\": \"Sim Polls / s\",\n      \"type\": \"int\",\n      \"default\": 8,\n      \"min\": 1,\n      \"max\": 100\n    }\n  ],\n  \"controls\": [\n    {\n      \"id\": \"pressed\",\n      \"label\": \"Pressed\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 1,\n      \"step\": 1,\n      \"unit\": \"\"\n    }\n  ]\n}\n",
        "wasmBase64": "",
        "romBytes": "",
        "programFile": "",
        "programTarget": "",
        "image": "data:image/svg+xml;base64,",
        "sourceHash": "e9e491aa"
      }
    }
