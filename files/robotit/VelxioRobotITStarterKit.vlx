    {
      "id": "custom_chip_1794828793650_zg2voopv9",
      "metadataId": "custom-chip",
      "x": 974,
      "y": -16,
      "properties": {
        "chipName": "Motor Left",
        "sourceC": "#include \"velxio-chip.h\"\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/*\n * N20 gear motor with Hall encoder (GA12-N20 class, 1:150, 7 PPR).\n *\n * QEMU-friendly model:\n * - 5.0 ms (200 Hz) tick with 10-sample (50 ms) moving-average voltage filter\n *   matching the 20 Hz software PWM period 1:1.\n * - 40 decimated quadrature states/rev with lossless +/-1 step emission.\n * - Non-blocking vx_net_request/vx_net_poll at 10 Hz default (zero JSON work\n *   while a request is in flight) and exponential backoff when offline.\n */\n\n#define MOTOR_TAG          \"Motor Left\"\n#define MOTOR_SIDE         \"left\"\n#define DEFAULT_URL        \"http://127.0.0.1:8765/api/motor/left\"\n#define LFSR_SEED          0xACE12345U\n\n#define RATED_VOLTAGE_V    12.0\n#define RATED_NO_LOAD_RPM  200.0\n\n/* Keep in sync with N20_COUNTS_PER_REV in main.c. */\n#define ENCODER_STATES_PER_REV  40.0\n\n#define SAMPLE_PERIOD_NS   5000000ULL\n#define DT_SEC             0.005000\n#define ENC_REFRESH_TICKS  20\n#define DIAG_EVERY_TICKS   200\n#define STALL_VOLTAGE_V    0.6\n#define DRIVE_THRESHOLD_V  1.0\n#define MECH_TAU_SEC       0.060\n#define MECH_ALPHA         (DT_SEC / (MECH_TAU_SEC + DT_SEC))\n#define AVG_WINDOW         10\n#define MIN_BACKOFF_NS     100000000ULL\n#define MAX_BACKOFF_NS     2000000000ULL\n\ntypedef struct {\n  vx_pin pin_m1;\n  vx_pin pin_gnd;\n  vx_pin pin_enca;\n  vx_pin pin_encb;\n  vx_pin pin_vcc;\n  vx_pin pin_m2;\n\n  vx_attr attr_supply_voltage;\n  vx_attr attr_mechanical_load;\n  vx_attr attr_gear_ratio;\n  vx_attr attr_url;\n  vx_attr attr_rate;\n\n  double   v_ring[AVG_WINDOW];\n  double   v_ring_sum;\n  int      v_ring_idx;\n  int      v_ring_count;\n  double   filtered_volts;\n  double   phase_accumulator;\n  long     emitted_steps;\n  double   no_load_rpm;\n  double   shaft_rpm;\n  double   sim_scale_pct;\n  double   sim_enc_scale_pct;\n  double   sim_extra_load_pct;\n  int      last_quad_state;\n  int      ticks_since_write;\n  int      diag_ticks;\n  int      online;\n  int      link_ok;\n  int      req_in_flight;\n  int      logged_offline;\n  uint32_t lfsr;\n  uint64_t next_net_ns;\n  uint64_t backoff_ns;\n  char     url[256];\n  char     reply[256];\n  vx_timer sim_timer;\n} chip_state_t;\n\nstatic chip_state_t S;\n\nstatic const int QUAD_TABLE_A[4] = { VX_HIGH, VX_HIGH, VX_LOW,  VX_LOW };\nstatic const int QUAD_TABLE_B[4] = { VX_LOW,  VX_HIGH, VX_HIGH, VX_LOW };\n\nstatic double abs_val(double x) {\n  return (x < 0.0) ? -x : x;\n}\n\nstatic double clamp_val(double x, double lo, double hi) {\n  if (x < lo) return lo;\n  if (x > hi) return hi;\n  return x;\n}\n\nstatic int floor_to_int(double x) {\n  int i = (int)x;\n  return (x < (double)i) ? (i - 1) : i;\n}\n\nstatic double rand_bipolar(void) {\n  uint32_t x = S.lfsr;\n  x ^= x << 13;\n  x ^= x >> 17;\n  x ^= x << 5;\n  S.lfsr = x;\n  return ((double)(x & 0xFFFFU) / 32768.0) - 1.0;\n}\n\nstatic const char *url_of(void) {\n  uint32_t n = vx_attr_string_read(S.attr_url, S.url, (uint32_t)sizeof(S.url));\n  return (n > 0 && S.url[0]) ? S.url : DEFAULT_URL;\n}\n\nstatic int json_double(const char *js, const char *key, double *out) {\n  char pat[48];\n  snprintf(pat, sizeof(pat), \"\\\"%s\\\"\", key);\n  const char *p = strstr(js, pat);\n  if (!p) return 0;\n  p = strchr(p + strlen(pat), ':');\n  if (!p) return 0;\n  char *endp = NULL;\n  double val = strtod(p + 1, &endp);\n  if (endp == p + 1) return 0;\n  *out = val;\n  return 1;\n}\n\nstatic void log_diag(double v1, double v2, int d1, int d2, double volts) {\n  char buf[192];\n  snprintf(buf, sizeof(buf),\n           MOTOR_TAG \": V(M1)=%.2f V(M2)=%.2f dig=%d/%d Vterm=%.2f rpm=%.1f scale=%.1f%% link=%d\",\n           v1, v2, d1, d2, volts, S.shaft_rpm, S.sim_scale_pct, S.link_ok);\n  vx_log(buf);\n}\n\nstatic double terminal_volts(double *v1_out, double *v2_out, int *d1_out, int *d2_out) {\n  double v1 = vx_pin_read_analog(S.pin_m1);\n  double v2 = vx_pin_read_analog(S.pin_m2);\n  int d1 = (vx_pin_read(S.pin_m1) != VX_LOW);\n  int d2 = (vx_pin_read(S.pin_m2) != VX_LOW);\n  *v1_out = v1; *v2_out = v2; *d1_out = d1; *d2_out = d2;\n\n  if (v1 > 0.0 || v2 > 0.0) {\n    return v1 - v2;\n  }\n\n  double v_supply = vx_attr_read(S.attr_supply_voltage);\n  if (v_supply <= 0.1) v_supply = 10.0;\n  if (d1 && !d2) return v_supply;\n  if (!d1 && d2) return -v_supply;\n  (void)DRIVE_THRESHOLD_V;\n  return 0.0;\n}\n\nstatic void handle_net_error(uint64_t now) {\n  if (S.link_ok || !S.logged_offline) {\n    vx_log(MOTOR_TAG \": simulator unreachable (running standalone local model)\");\n    S.logged_offline = 1;\n  }\n  S.link_ok = 0;\n  S.sim_scale_pct = 100.0;\n  S.sim_enc_scale_pct = 100.0;\n  S.sim_extra_load_pct = 0.0;\n  S.next_net_ns = now + S.backoff_ns;\n  if (S.backoff_ns < MAX_BACKOFF_NS) {\n    S.backoff_ns *= 2ULL;\n    if (S.backoff_ns > MAX_BACKOFF_NS) S.backoff_ns = MAX_BACKOFF_NS;\n  }\n}\n\nstatic void step_network(double volts) {\n  if (!S.online) return;\n  uint64_t now = vx_sim_now_nanos();\n\n  if (S.req_in_flight) {\n    int32_t n = vx_net_poll();\n    if (n == VX_NET_BUSY) return;\n    S.req_in_flight = 0;\n    if (n < 0) {\n      handle_net_error(now);\n      return;\n    }\n\n    int32_t got = vx_net_resp_read(0, S.reply, (uint32_t)(sizeof(S.reply) - 1));\n    S.reply[got > 0 ? got : 0] = '\\0';\n    S.link_ok = (vx_net_status() == 200);\n    if (S.link_ok) {\n      S.logged_offline = 0;\n      S.backoff_ns = MIN_BACKOFF_NS;\n      double extra = 0.0;\n      if (json_double(S.reply, \"load_pct\", &extra)) {\n        S.sim_extra_load_pct = clamp_val(extra, 0.0, 95.0);\n      } else {\n        S.sim_extra_load_pct = 0.0;\n      }\n\n      double sc = 100.0;\n      if (json_double(S.reply, \"scale_pct\", &sc)) {\n        S.sim_scale_pct = clamp_val(sc, 5.0, 150.0);\n      } else {\n        S.sim_scale_pct = clamp_val(100.0 - S.sim_extra_load_pct, 5.0, 100.0);\n      }\n\n      double esc = S.sim_scale_pct;\n      if (json_double(S.reply, \"enc_scale_pct\", &esc)) {\n        S.sim_enc_scale_pct = clamp_val(esc, 5.0, 160.0);\n      } else {\n        S.sim_enc_scale_pct = S.sim_scale_pct;\n      }\n    } else {\n      S.sim_scale_pct = 100.0;\n      S.sim_enc_scale_pct = 100.0;\n      S.sim_extra_load_pct = 0.0;\n    }\n\n    double rate = vx_attr_read(S.attr_rate);\n    if (rate < 1.0) rate = 10.0;\n    if (rate > 100.0) rate = 100.0;\n    S.next_net_ns = now + (uint64_t)(1e9 / rate);\n    return;\n  }\n\n  if (now < S.next_net_ns) return;\n\n  char body[192];\n  snprintf(body, sizeof(body),\n           \"{\\\"v\\\":1,\\\"side\\\":\\\"%s\\\",\\\"volts\\\":%.2f,\\\"no_load_rpm\\\":%.2f,\\\"rpm\\\":%.2f,\\\"t_ns\\\":%llu}\",\n           MOTOR_SIDE, volts, S.no_load_rpm, S.shaft_rpm, (unsigned long long)now);\n\n  int32_t rc = vx_net_request(\"POST\", url_of(), \"text/plain\", body, (uint32_t)strlen(body));\n  if (rc == 0) {\n    S.req_in_flight = 1;\n  } else if (rc != VX_NET_BUSY) {\n    handle_net_error(now);\n  }\n}\n\nstatic void on_tick(void *user_data) {\n  int allow_net = (user_data != NULL);\n\n  double v1, v2;\n  int d1, d2;\n  double volts = terminal_volts(&v1, &v2, &d1, &d2);\n\n  S.v_ring_sum -= S.v_ring[S.v_ring_idx];\n  S.v_ring[S.v_ring_idx] = volts;\n  S.v_ring_sum += volts;\n  S.v_ring_idx = (S.v_ring_idx + 1) % AVG_WINDOW;\n  if (S.v_ring_count < AVG_WINDOW) S.v_ring_count++;\n  double avg_volts = S.v_ring_sum / (double)S.v_ring_count;\n\n  S.filtered_volts += MECH_ALPHA * (avg_volts - S.filtered_volts);\n\n  double attr_load  = clamp_val(vx_attr_read(S.attr_mechanical_load), 0.0, 100.0);\n  double gear_ratio = vx_attr_read(S.attr_gear_ratio);\n  if (gear_ratio < 1.0) gear_ratio = 150.0;\n\n  double mag = abs_val(S.filtered_volts);\n  double base_rpm = 0.0;\n  if (mag >= STALL_VOLTAGE_V) {\n    double dir         = (S.filtered_volts >= 0.0) ? 1.0 : -1.0;\n    double ratio_scale = 150.0 / gear_ratio;\n    base_rpm = dir * RATED_NO_LOAD_RPM * (mag / RATED_VOLTAGE_V) * (1.0 - attr_load * 0.01) * ratio_scale;\n  }\n  S.no_load_rpm = base_rpm;\n\n  double enc_rpm;\n  if (S.link_ok) {\n    S.shaft_rpm = base_rpm * (S.sim_scale_pct * 0.01);\n    enc_rpm     = base_rpm * (S.sim_enc_scale_pct * 0.01);\n  } else {\n    double jitter = 1.0 + 0.01 * rand_bipolar();\n    S.shaft_rpm = base_rpm * jitter;\n    enc_rpm     = S.shaft_rpm;\n  }\n\n  S.phase_accumulator += (enc_rpm / 60.0) * ENCODER_STATES_PER_REV * DT_SEC;\n  long target_steps = (long)floor_to_int(S.phase_accumulator + 0.5);\n  if (target_steps > S.emitted_steps) {\n    S.emitted_steps++;\n  } else if (target_steps < S.emitted_steps) {\n    S.emitted_steps--;\n  }\n  int quad_idx = (int)(S.emitted_steps & 3);\n\n  S.ticks_since_write++;\n  if (quad_idx != S.last_quad_state || S.ticks_since_write >= ENC_REFRESH_TICKS) {\n    vx_pin_write(S.pin_enca, QUAD_TABLE_A[quad_idx]);\n    vx_pin_write(S.pin_encb, QUAD_TABLE_B[quad_idx]);\n    S.last_quad_state   = quad_idx;\n    S.ticks_since_write = 0;\n  }\n\n  if (allow_net) {\n    step_network(avg_volts);\n  }\n\n  if (DIAG_EVERY_TICKS > 0 && ++S.diag_ticks >= DIAG_EVERY_TICKS) {\n    S.diag_ticks = 0;\n    log_diag(v1, v2, d1, d2, avg_volts);\n  }\n}\n\nvoid chip_setup(void) {\n  memset(&S, 0, sizeof(S));\n  S.last_quad_state   = -1;\n  S.sim_scale_pct     = 100.0;\n  S.sim_enc_scale_pct = 100.0;\n  S.lfsr              = LFSR_SEED;\n  S.backoff_ns        = MIN_BACKOFF_NS;\n\n  S.pin_m1   = vx_pin_register(\"M1\",   VX_INPUT);\n  S.pin_gnd  = vx_pin_register(\"GND\",  VX_INPUT_PULLDOWN);\n  S.pin_enca = vx_pin_register(\"ENCA\", VX_OUTPUT_HIGH);\n  S.pin_encb = vx_pin_register(\"ENCB\", VX_OUTPUT_LOW);\n  S.pin_vcc  = vx_pin_register(\"VCC\",  VX_INPUT_PULLUP);\n  S.pin_m2   = vx_pin_register(\"M2\",   VX_INPUT);\n\n  S.attr_supply_voltage  = vx_attr_register(\"supply_voltage\",  10.0);\n  S.attr_mechanical_load = vx_attr_register(\"mechanical_load\", 0.0);\n  S.attr_gear_ratio      = vx_attr_register(\"gear_ratio\",      150.0);\n  S.attr_url             = vx_attr_register_string(\"url\",      DEFAULT_URL);\n  S.attr_rate            = vx_attr_register(\"rate\",            10.0);\n\n  S.online      = (vx_net_available() != 0);\n  S.next_net_ns = SAMPLE_PERIOD_NS;\n\n  S.sim_timer = vx_timer_create(on_tick, &S);\n  vx_timer_start(S.sim_timer, SAMPLE_PERIOD_NS, true);\n\n  on_tick(NULL);\n  vx_log(S.online ? MOTOR_TAG \": N20 networked motor model ready (200 Hz, 40 cpt, 10 Hz net)\"\n                  : MOTOR_TAG \": N20 offline motor model ready (200 Hz, 40 cpt)\");\n}\n",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"Motor_Left\",\n  \"author\": \"Custom\",\n  \"description\": \"GA12-N20 gear motor, 1:150, 7 PPR Hall encoder (rated 12 V / 200 rpm no-load). Speed follows the solved terminal voltage V(M1)-V(M2); on the robot VM is the ~10 V boost rail.\",\n  \"pins\": [\n    { \"name\": \"ENCA\", \"x\": 4, \"y\": 34 },\n    { \"name\": \"ENCB\", \"x\": 4, \"y\": 43 },\n    { \"name\": \"VCC\", \"x\": 4, \"y\": 52 },\n    { \"name\": \"GND\", \"x\": 4, \"y\": 61 },\n    { \"name\": \"M1\", \"x\": 4, \"y\": 70 },\n    { \"name\": \"M2\", \"x\": 4, \"y\": 79 },\n    { \"name\": \"\", \"x\": 168, \"y\": 110 }\n  ],\n  \"attributes\": [\n    {\n      \"name\": \"supply_voltage\",\n      \"label\": \"Fallback VM (V), used only if no solved voltage is available\",\n      \"type\": \"float\",\n      \"default\": 10,\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.5\n    },\n    {\n      \"name\": \"mechanical_load\",\n      \"label\": \"Mechanical Shaft Load (%)\",\n      \"type\": \"float\",\n      \"default\": 0,\n      \"min\": 0,\n      \"max\": 100,\n      \"step\": 5\n    },\n    {\n      \"name\": \"gear_ratio\",\n      \"label\": \"Gear Reduction Ratio (:1)\",\n      \"type\": \"float\",\n      \"default\": 150,\n      \"min\": 10,\n      \"max\": 300,\n      \"step\": 10\n    },\n    {\n      \"name\": \"url\",\n      \"label\": \"Simulator URL\",\n      \"type\": \"string\",\n      \"default\": \"http://127.0.0.1:8765/api/motor/left\"\n    },\n    {\n      \"name\": \"rate\",\n      \"label\": \"Sim Polls / s\",\n      \"type\": \"int\",\n      \"default\": 10,\n      \"min\": 1,\n      \"max\": 100\n    }\n  ],\n  \"controls\": [\n    {\n      \"id\": \"supply_voltage\",\n      \"label\": \"Motor Supply Voltage\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.5,\n      \"unit\": \"V\"\n    },\n    {\n      \"id\": \"mechanical_load\",\n      \"label\": \"Mechanical Shaft Load\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 100,\n      \"step\": 5,\n      \"unit\": \"%\"\n    },\n    {\n      \"id\": \"gear_ratio\",\n      \"label\": \"Gear Reduction Ratio\",\n      \"type\": \"range\",\n      \"min\": 10,\n      \"max\": 300,\n      \"step\": 10,\n      \"unit\": \":1\"\n    }\n  ]\n}\n",
        "wasmBase64": "",
        "romBytes": "",
        "programFile": "",
        "programTarget": "",
        "image": "data:image/svg+xml;base64,",
        "sourceHash": "df0fe016"
      }
    },
    {
      "id": "custom_chip_1794830273302_goqv3hge4",
      "metadataId": "custom-chip",
      "x": 714,
      "y": -16,
      "properties": {
        "chipName": "Motor Right",
        "sourceC": "#include \"velxio-chip.h\"\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/*\n * N20 gear motor with Hall encoder (GA12-N20 class, 1:150, 7 PPR).\n *\n * QEMU-friendly model:\n * - 5.0 ms (200 Hz) tick with 10-sample (50 ms) moving-average voltage filter\n *   matching the 20 Hz software PWM period 1:1.\n * - 40 decimated quadrature states/rev with lossless +/-1 step emission.\n * - Non-blocking vx_net_request/vx_net_poll at 10 Hz default (zero JSON work\n *   while a request is in flight) and exponential backoff when offline.\n */\n\n#define MOTOR_TAG          \"Motor Right\"\n#define MOTOR_SIDE         \"right\"\n#define DEFAULT_URL        \"http://127.0.0.1:8765/api/motor/right\"\n#define LFSR_SEED          0xBEEF5678U\n\n#define RATED_VOLTAGE_V    12.0\n#define RATED_NO_LOAD_RPM  200.0\n\n/* Keep in sync with N20_COUNTS_PER_REV in main.c. */\n#define ENCODER_STATES_PER_REV  40.0\n\n#define SAMPLE_PERIOD_NS   5000000ULL\n#define DT_SEC             0.005000\n#define ENC_REFRESH_TICKS  20\n#define DIAG_EVERY_TICKS   200\n#define STALL_VOLTAGE_V    0.6\n#define DRIVE_THRESHOLD_V  1.0\n#define MECH_TAU_SEC       0.060\n#define MECH_ALPHA         (DT_SEC / (MECH_TAU_SEC + DT_SEC))\n#define AVG_WINDOW         10\n#define MIN_BACKOFF_NS     100000000ULL\n#define MAX_BACKOFF_NS     2000000000ULL\n\ntypedef struct {\n  vx_pin pin_m1;\n  vx_pin pin_gnd;\n  vx_pin pin_enca;\n  vx_pin pin_encb;\n  vx_pin pin_vcc;\n  vx_pin pin_m2;\n\n  vx_attr attr_supply_voltage;\n  vx_attr attr_mechanical_load;\n  vx_attr attr_gear_ratio;\n  vx_attr attr_url;\n  vx_attr attr_rate;\n\n  double   v_ring[AVG_WINDOW];\n  double   v_ring_sum;\n  int      v_ring_idx;\n  int      v_ring_count;\n  double   filtered_volts;\n  double   phase_accumulator;\n  long     emitted_steps;\n  double   no_load_rpm;\n  double   shaft_rpm;\n  double   sim_scale_pct;\n  double   sim_enc_scale_pct;\n  double   sim_extra_load_pct;\n  int      last_quad_state;\n  int      ticks_since_write;\n  int      diag_ticks;\n  int      online;\n  int      link_ok;\n  int      req_in_flight;\n  int      logged_offline;\n  uint32_t lfsr;\n  uint64_t next_net_ns;\n  uint64_t backoff_ns;\n  char     url[256];\n  char     reply[256];\n  vx_timer sim_timer;\n} chip_state_t;\n\nstatic chip_state_t S;\n\nstatic const int QUAD_TABLE_A[4] = { VX_HIGH, VX_HIGH, VX_LOW,  VX_LOW };\nstatic const int QUAD_TABLE_B[4] = { VX_LOW,  VX_HIGH, VX_HIGH, VX_LOW };\n\nstatic double abs_val(double x) {\n  return (x < 0.0) ? -x : x;\n}\n\nstatic double clamp_val(double x, double lo, double hi) {\n  if (x < lo) return lo;\n  if (x > hi) return hi;\n  return x;\n}\n\nstatic int floor_to_int(double x) {\n  int i = (int)x;\n  return (x < (double)i) ? (i - 1) : i;\n}\n\nstatic double rand_bipolar(void) {\n  uint32_t x = S.lfsr;\n  x ^= x << 13;\n  x ^= x >> 17;\n  x ^= x << 5;\n  S.lfsr = x;\n  return ((double)(x & 0xFFFFU) / 32768.0) - 1.0;\n}\n\nstatic const char *url_of(void) {\n  uint32_t n = vx_attr_string_read(S.attr_url, S.url, (uint32_t)sizeof(S.url));\n  return (n > 0 && S.url[0]) ? S.url : DEFAULT_URL;\n}\n\nstatic int json_double(const char *js, const char *key, double *out) {\n  char pat[48];\n  snprintf(pat, sizeof(pat), \"\\\"%s\\\"\", key);\n  const char *p = strstr(js, pat);\n  if (!p) return 0;\n  p = strchr(p + strlen(pat), ':');\n  if (!p) return 0;\n  char *endp = NULL;\n  double val = strtod(p + 1, &endp);\n  if (endp == p + 1) return 0;\n  *out = val;\n  return 1;\n}\n\nstatic void log_diag(double v1, double v2, int d1, int d2, double volts) {\n  char buf[192];\n  snprintf(buf, sizeof(buf),\n           MOTOR_TAG \": V(M1)=%.2f V(M2)=%.2f dig=%d/%d Vterm=%.2f rpm=%.1f scale=%.1f%% link=%d\",\n           v1, v2, d1, d2, volts, S.shaft_rpm, S.sim_scale_pct, S.link_ok);\n  vx_log(buf);\n}\n\nstatic double terminal_volts(double *v1_out, double *v2_out, int *d1_out, int *d2_out) {\n  double v1 = vx_pin_read_analog(S.pin_m1);\n  double v2 = vx_pin_read_analog(S.pin_m2);\n  int d1 = (vx_pin_read(S.pin_m1) != VX_LOW);\n  int d2 = (vx_pin_read(S.pin_m2) != VX_LOW);\n  *v1_out = v1; *v2_out = v2; *d1_out = d1; *d2_out = d2;\n\n  if (v1 > 0.0 || v2 > 0.0) {\n    return v1 - v2;\n  }\n\n  double v_supply = vx_attr_read(S.attr_supply_voltage);\n  if (v_supply <= 0.1) v_supply = 10.0;\n  if (d1 && !d2) return v_supply;\n  if (!d1 && d2) return -v_supply;\n  (void)DRIVE_THRESHOLD_V;\n  return 0.0;\n}\n\nstatic void handle_net_error(uint64_t now) {\n  if (S.link_ok || !S.logged_offline) {\n    vx_log(MOTOR_TAG \": simulator unreachable (running standalone local model)\");\n    S.logged_offline = 1;\n  }\n  S.link_ok = 0;\n  S.sim_scale_pct = 100.0;\n  S.sim_enc_scale_pct = 100.0;\n  S.sim_extra_load_pct = 0.0;\n  S.next_net_ns = now + S.backoff_ns;\n  if (S.backoff_ns < MAX_BACKOFF_NS) {\n    S.backoff_ns *= 2ULL;\n    if (S.backoff_ns > MAX_BACKOFF_NS) S.backoff_ns = MAX_BACKOFF_NS;\n  }\n}\n\nstatic void step_network(double volts) {\n  if (!S.online) return;\n  uint64_t now = vx_sim_now_nanos();\n\n  if (S.req_in_flight) {\n    int32_t n = vx_net_poll();\n    if (n == VX_NET_BUSY) return;\n    S.req_in_flight = 0;\n    if (n < 0) {\n      handle_net_error(now);\n      return;\n    }\n\n    int32_t got = vx_net_resp_read(0, S.reply, (uint32_t)(sizeof(S.reply) - 1));\n    S.reply[got > 0 ? got : 0] = '\\0';\n    S.link_ok = (vx_net_status() == 200);\n    if (S.link_ok) {\n      S.logged_offline = 0;\n      S.backoff_ns = MIN_BACKOFF_NS;\n      double extra = 0.0;\n      if (json_double(S.reply, \"load_pct\", &extra)) {\n        S.sim_extra_load_pct = clamp_val(extra, 0.0, 95.0);\n      } else {\n        S.sim_extra_load_pct = 0.0;\n      }\n\n      double sc = 100.0;\n      if (json_double(S.reply, \"scale_pct\", &sc)) {\n        S.sim_scale_pct = clamp_val(sc, 5.0, 150.0);\n      } else {\n        S.sim_scale_pct = clamp_val(100.0 - S.sim_extra_load_pct, 5.0, 100.0);\n      }\n\n      double esc = S.sim_scale_pct;\n      if (json_double(S.reply, \"enc_scale_pct\", &esc)) {\n        S.sim_enc_scale_pct = clamp_val(esc, 5.0, 160.0);\n      } else {\n        S.sim_enc_scale_pct = S.sim_scale_pct;\n      }\n    } else {\n      S.sim_scale_pct = 100.0;\n      S.sim_enc_scale_pct = 100.0;\n      S.sim_extra_load_pct = 0.0;\n    }\n\n    double rate = vx_attr_read(S.attr_rate);\n    if (rate < 1.0) rate = 10.0;\n    if (rate > 100.0) rate = 100.0;\n    S.next_net_ns = now + (uint64_t)(1e9 / rate);\n    return;\n  }\n\n  if (now < S.next_net_ns) return;\n\n  char body[192];\n  snprintf(body, sizeof(body),\n           \"{\\\"v\\\":1,\\\"side\\\":\\\"%s\\\",\\\"volts\\\":%.2f,\\\"no_load_rpm\\\":%.2f,\\\"rpm\\\":%.2f,\\\"t_ns\\\":%llu}\",\n           MOTOR_SIDE, volts, S.no_load_rpm, S.shaft_rpm, (unsigned long long)now);\n\n  int32_t rc = vx_net_request(\"POST\", url_of(), \"text/plain\", body, (uint32_t)strlen(body));\n  if (rc == 0) {\n    S.req_in_flight = 1;\n  } else if (rc != VX_NET_BUSY) {\n    handle_net_error(now);\n  }\n}\n\nstatic void on_tick(void *user_data) {\n  int allow_net = (user_data != NULL);\n\n  double v1, v2;\n  int d1, d2;\n  double volts = terminal_volts(&v1, &v2, &d1, &d2);\n\n  S.v_ring_sum -= S.v_ring[S.v_ring_idx];\n  S.v_ring[S.v_ring_idx] = volts;\n  S.v_ring_sum += volts;\n  S.v_ring_idx = (S.v_ring_idx + 1) % AVG_WINDOW;\n  if (S.v_ring_count < AVG_WINDOW) S.v_ring_count++;\n  double avg_volts = S.v_ring_sum / (double)S.v_ring_count;\n\n  S.filtered_volts += MECH_ALPHA * (avg_volts - S.filtered_volts);\n\n  double attr_load  = clamp_val(vx_attr_read(S.attr_mechanical_load), 0.0, 100.0);\n  double gear_ratio = vx_attr_read(S.attr_gear_ratio);\n  if (gear_ratio < 1.0) gear_ratio = 150.0;\n\n  double mag = abs_val(S.filtered_volts);\n  double base_rpm = 0.0;\n  if (mag >= STALL_VOLTAGE_V) {\n    double dir         = (S.filtered_volts >= 0.0) ? 1.0 : -1.0;\n    double ratio_scale = 150.0 / gear_ratio;\n    base_rpm = dir * RATED_NO_LOAD_RPM * (mag / RATED_VOLTAGE_V) * (1.0 - attr_load * 0.01) * ratio_scale;\n  }\n  S.no_load_rpm = base_rpm;\n\n  double enc_rpm;\n  if (S.link_ok) {\n    S.shaft_rpm = base_rpm * (S.sim_scale_pct * 0.01);\n    enc_rpm     = base_rpm * (S.sim_enc_scale_pct * 0.01);\n  } else {\n    double jitter = 1.0 + 0.01 * rand_bipolar();\n    S.shaft_rpm = base_rpm * jitter;\n    enc_rpm     = S.shaft_rpm;\n  }\n\n  S.phase_accumulator += (enc_rpm / 60.0) * ENCODER_STATES_PER_REV * DT_SEC;\n  long target_steps = (long)floor_to_int(S.phase_accumulator + 0.5);\n  if (target_steps > S.emitted_steps) {\n    S.emitted_steps++;\n  } else if (target_steps < S.emitted_steps) {\n    S.emitted_steps--;\n  }\n  int quad_idx = (int)(S.emitted_steps & 3);\n\n  S.ticks_since_write++;\n  if (quad_idx != S.last_quad_state || S.ticks_since_write >= ENC_REFRESH_TICKS) {\n    vx_pin_write(S.pin_enca, QUAD_TABLE_A[quad_idx]);\n    vx_pin_write(S.pin_encb, QUAD_TABLE_B[quad_idx]);\n    S.last_quad_state   = quad_idx;\n    S.ticks_since_write = 0;\n  }\n\n  if (allow_net) {\n    step_network(avg_volts);\n  }\n\n  if (DIAG_EVERY_TICKS > 0 && ++S.diag_ticks >= DIAG_EVERY_TICKS) {\n    S.diag_ticks = 0;\n    log_diag(v1, v2, d1, d2, avg_volts);\n  }\n}\n\nvoid chip_setup(void) {\n  memset(&S, 0, sizeof(S));\n  S.last_quad_state   = -1;\n  S.sim_scale_pct     = 100.0;\n  S.sim_enc_scale_pct = 100.0;\n  S.lfsr              = LFSR_SEED;\n  S.backoff_ns        = MIN_BACKOFF_NS;\n\n  S.pin_m1   = vx_pin_register(\"M1\",   VX_INPUT);\n  S.pin_gnd  = vx_pin_register(\"GND\",  VX_INPUT_PULLDOWN);\n  S.pin_enca = vx_pin_register(\"ENCA\", VX_OUTPUT_HIGH);\n  S.pin_encb = vx_pin_register(\"ENCB\", VX_OUTPUT_LOW);\n  S.pin_vcc  = vx_pin_register(\"VCC\",  VX_INPUT_PULLUP);\n  S.pin_m2   = vx_pin_register(\"M2\",   VX_INPUT);\n\n  S.attr_supply_voltage  = vx_attr_register(\"supply_voltage\",  10.0);\n  S.attr_mechanical_load = vx_attr_register(\"mechanical_load\", 0.0);\n  S.attr_gear_ratio      = vx_attr_register(\"gear_ratio\",      150.0);\n  S.attr_url             = vx_attr_register_string(\"url\",      DEFAULT_URL);\n  S.attr_rate            = vx_attr_register(\"rate\",            10.0);\n\n  S.online      = (vx_net_available() != 0);\n  S.next_net_ns = SAMPLE_PERIOD_NS;\n\n  S.sim_timer = vx_timer_create(on_tick, &S);\n  vx_timer_start(S.sim_timer, SAMPLE_PERIOD_NS, true);\n\n  on_tick(NULL);\n  vx_log(S.online ? MOTOR_TAG \": N20 networked motor model ready (200 Hz, 40 cpt, 10 Hz net)\"\n                  : MOTOR_TAG \": N20 offline motor model ready (200 Hz, 40 cpt)\");\n}\n",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"Motor_Right\",\n  \"author\": \"Custom\",\n  \"description\": \"GA12-N20 gear motor, 1:150, 7 PPR Hall encoder (rated 12 V / 200 rpm no-load). Speed follows the solved terminal voltage V(M1)-V(M2); on the robot VM is the ~10 V boost rail.\",\n  \"pins\": [\n    { \"name\": \"ENCA\", \"x\": 4, \"y\": 34 },\n    { \"name\": \"ENCB\", \"x\": 4, \"y\": 43 },\n    { \"name\": \"VCC\", \"x\": 4, \"y\": 52 },\n    { \"name\": \"GND\", \"x\": 4, \"y\": 61 },\n    { \"name\": \"M1\", \"x\": 4, \"y\": 70 },\n    { \"name\": \"M2\", \"x\": 4, \"y\": 79 },\n    { \"name\": \"\", \"x\": 168, \"y\": 110 }\n  ],\n  \"attributes\": [\n    {\n      \"name\": \"supply_voltage\",\n      \"label\": \"Fallback VM (V), used only if no solved voltage is available\",\n      \"type\": \"float\",\n      \"default\": 10,\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.5\n    },\n    {\n      \"name\": \"mechanical_load\",\n      \"label\": \"Mechanical Shaft Load (%)\",\n      \"type\": \"float\",\n      \"default\": 0,\n      \"min\": 0,\n      \"max\": 100,\n      \"step\": 5\n    },\n    {\n      \"name\": \"gear_ratio\",\n      \"label\": \"Gear Reduction Ratio (:1)\",\n      \"type\": \"float\",\n      \"default\": 150,\n      \"min\": 10,\n      \"max\": 300,\n      \"step\": 10\n    },\n    {\n      \"name\": \"url\",\n      \"label\": \"Simulator URL\",\n      \"type\": \"string\",\n      \"default\": \"http://127.0.0.1:8765/api/motor/right\"\n    },\n    {\n      \"name\": \"rate\",\n      \"label\": \"Sim Polls / s\",\n      \"type\": \"int\",\n      \"default\": 10,\n      \"min\": 1,\n      \"max\": 100\n    }\n  ],\n  \"controls\": [\n    {\n      \"id\": \"supply_voltage\",\n      \"label\": \"Motor Supply Voltage\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.5,\n      \"unit\": \"V\"\n    },\n    {\n      \"id\": \"mechanical_load\",\n      \"label\": \"Mechanical Shaft Load\",\n      \"type\": \"range\",\n      \"min\": 0,\n      \"max\": 100,\n      \"step\": 5,\n      \"unit\": \"%\"\n    },\n    {\n      \"id\": \"gear_ratio\",\n      \"label\": \"Gear Reduction Ratio\",\n      \"type\": \"range\",\n      \"min\": 10,\n      \"max\": 300,\n      \"step\": 10,\n      \"unit\": \":1\"\n    }\n  ]\n}\n",
        "wasmBase64": "",
        "romBytes": "",
        "programFile": "",
        "programTarget": "",
        "image": "data:image/svg+xml;base64,",
        "sourceHash": "ea8ebcb3"
      }
    },
    {
      "id": "custom_chip_1794831058441_o5kbdc20j",
      "metadataId": "custom-chip",
      "x": -276,
      "y": 190,
      "properties": {
        "chipName": "Sensor_Array",
        "sourceC": "#include \"velxio-chip.h\"\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/*\n * 3x VL53L0X Time-of-Flight I2C Array for Velxio\n * - Default 7-bit I2C Address: 0x29 (programmable via reg 0x8A)\n * - Enable Pins: XSHUT1 (Left), XSHUT2 (Center), XSHUT3 (Right)\n * - Uses 20 ms (50 Hz) tick and vx_net_request/vx_net_poll at 10 Hz default.\n * - Falls back to standalone 200-800 mm sine wave when offline.\n */\n\n#define VL53L0X_DEFAULT_ADDR 0x29\n#define DEFAULT_URL          \"http://127.0.0.1:8765/api/tof\"\n#define TICK_PERIOD_NS       20000000ULL\n#define MIN_BACKOFF_NS       100000000ULL\n#define MAX_BACKOFF_NS       2000000000ULL\n#define PI_VAL               3.14159265358979323846\n#define TWO_PI_VAL           6.28318530717958647692\n\ntypedef struct {\n  vx_pin   pin_xshut;\n  uint8_t  i2c_addr;\n  uint8_t  regs[256];\n  uint8_t  page;\n  uint16_t dist_mm;\n  double   phase_offset;\n  int      was_enabled;\n} vl53_unit_t;\n\ntypedef struct {\n  vx_pin      pin_vcc;\n  vx_pin      pin_gnd;\n  vx_pin      pin_sda;\n  vx_pin      pin_scl;\n  vl53_unit_t units[3];\n\n  int      active_unit;\n  uint8_t  reg_ptr;\n  int      expect_reg_addr;\n\n  vx_attr  attr_freq_hz;\n  vx_attr  attr_noise_mm;\n  vx_attr  attr_url;\n  vx_attr  attr_rate;\n\n  int      online;\n  int      link_ok;\n  int      req_in_flight;\n  int      logged_offline;\n  uint16_t sim_dist_mm[3];\n  uint64_t next_net_ns;\n  uint64_t backoff_ns;\n  char     url[256];\n  char     reply[256];\n\n  uint32_t lfsr;\n  vx_timer sim_timer;\n} vl53_array_t;\n\nstatic vl53_array_t S;\n\nstatic double fast_sin(double rad) {\n  while (rad > PI_VAL)  rad -= TWO_PI_VAL;\n  while (rad < -PI_VAL) rad += TWO_PI_VAL;\n  double x2 = rad * rad;\n  return rad * (1.0 - x2 * (1.0 / 6.0 - x2 * (1.0 / 120.0 - x2 * (1.0 / 5040.0))));\n}\n\nstatic double rand_bipolar(void) {\n  uint32_t x = S.lfsr;\n  x ^= x << 13;\n  x ^= x >> 17;\n  x ^= x << 5;\n  S.lfsr = x;\n  return ((double)(x & 0xFFFFU) / 32768.0) - 1.0;\n}\n\nstatic const char *url_of(void) {\n  uint32_t n = vx_attr_string_read(S.attr_url, S.url, (uint32_t)sizeof(S.url));\n  return (n > 0 && S.url[0]) ? S.url : DEFAULT_URL;\n}\n\nstatic int json_long(const char *js, const char *key, long *out) {\n  char pat[48];\n  snprintf(pat, sizeof(pat), \"\\\"%s\\\"\", key);\n  const char *p = strstr(js, pat);\n  if (!p) return 0;\n  p = strchr(p + strlen(pat), ':');\n  if (!p) return 0;\n  char *endp = NULL;\n  long val = strtol(p + 1, &endp, 10);\n  if (endp == p + 1) return 0;\n  *out = val;\n  return 1;\n}\n\nstatic void reset_unit_registers(vl53_unit_t *u) {\n  for (int i = 0; i < 256; i++) {\n    u->regs[i] = 0x00;\n  }\n  u->i2c_addr   = VL53L0X_DEFAULT_ADDR;\n  u->page       = 0x00;\n\n  u->regs[0xC0] = 0xEE;\n  u->regs[0xC1] = 0xAA;\n  u->regs[0xC2] = 0x10;\n  u->regs[0x51] = 0x00;\n  u->regs[0x61] = 0x00;\n\n  u->regs[0x80] = 0x01;\n  u->regs[0x83] = 0x01;\n  u->regs[0x84] = 0x00;\n  u->regs[0x88] = 0x00;\n  u->regs[0x89] = 0x01;\n  u->regs[0x8A] = VL53L0X_DEFAULT_ADDR;\n  u->regs[0x91] = 0x3C;\n  u->regs[0x92] = 0x06;\n  u->regs[0x01] = 0xFF;\n  u->regs[0x04] = 0x01;\n  u->regs[0x60] = 0x00;\n\n  u->regs[0xB0] = 0x3F;\n  u->regs[0xB1] = 0x00;\n  u->regs[0xB2] = 0x00;\n  u->regs[0xB3] = 0x00;\n  u->regs[0xB4] = 0x00;\n  u->regs[0xB5] = 0x00;\n\n  u->regs[0x00] = 0x00;\n  u->regs[0x13] = 0x07;\n  u->regs[0x14] = 0x01;\n}\n\nstatic void update_unit_distance_regs(vl53_unit_t *u, uint16_t mm) {\n  u->dist_mm = mm;\n  u->regs[0x00] = 0x00;\n  u->regs[0x13] = 0x07;\n  u->regs[0x14] = 0x00;\n  u->regs[0x1E] = (uint8_t)((mm >> 8) & 0xFF);\n  u->regs[0x1F] = (uint8_t)(mm & 0xFF);\n}\n\nstatic void refresh_unit_distances(void) {\n  double t_sec    = (double)vx_sim_now_nanos() * 1e-9;\n  double freq_hz  = vx_attr_read(S.attr_freq_hz);\n  double noise_mm = vx_attr_read(S.attr_noise_mm);\n  if (freq_hz < 0.05) freq_hz = 0.5;\n  if (noise_mm < 0.0) noise_mm = 0.0;\n\n  for (int i = 0; i < 3; i++) {\n    vl53_unit_t *u = &S.units[i];\n    int en = (vx_pin_read(u->pin_xshut) == VX_HIGH);\n\n    if (!en) {\n      if (u->was_enabled) {\n        reset_unit_registers(u);\n        u->was_enabled = 0;\n      }\n      continue;\n    }\n    u->was_enabled = 1;\n\n    uint16_t mm;\n    if (S.link_ok) {\n      mm = S.sim_dist_mm[i];\n    } else {\n      double angle = TWO_PI_VAL * freq_hz * t_sec + u->phase_offset;\n      double raw_mm = 500.0 + 300.0 * fast_sin(angle) + (noise_mm * rand_bipolar());\n      if (raw_mm < 200.0) raw_mm = 200.0;\n      if (raw_mm > 800.0) raw_mm = 800.0;\n      mm = (uint16_t)(raw_mm + 0.5);\n    }\n\n    update_unit_distance_regs(u, mm);\n  }\n}\n\nstatic void handle_net_error(uint64_t now) {\n  if (S.link_ok || !S.logged_offline) {\n    vx_log(\"VL53L0X_3x_Array: simulator unreachable (using offline sine fallback)\");\n    S.logged_offline = 1;\n  }\n  S.link_ok = 0;\n  S.next_net_ns = now + S.backoff_ns;\n  if (S.backoff_ns < MAX_BACKOFF_NS) {\n    S.backoff_ns *= 2ULL;\n    if (S.backoff_ns > MAX_BACKOFF_NS) S.backoff_ns = MAX_BACKOFF_NS;\n  }\n}\n\nstatic void step_network(void) {\n  if (!S.online) return;\n  uint64_t now = vx_sim_now_nanos();\n\n  if (S.req_in_flight) {\n    int32_t n = vx_net_poll();\n    if (n == VX_NET_BUSY) return;\n    S.req_in_flight = 0;\n    if (n < 0) {\n      handle_net_error(now);\n      return;\n    }\n\n    int32_t got = vx_net_resp_read(0, S.reply, (uint32_t)(sizeof(S.reply) - 1));\n    S.reply[got > 0 ? got : 0] = '\\0';\n    S.link_ok = (vx_net_status() == 200);\n    if (S.link_ok) {\n      S.logged_offline = 0;\n      S.backoff_ns = MIN_BACKOFF_NS;\n      long d1 = 0, d2 = 0, d3 = 0;\n      if (json_long(S.reply, \"d1\", &d1)) S.sim_dist_mm[0] = (uint16_t)(d1 < 20 ? 20 : (d1 > 2000 ? 2000 : d1));\n      if (json_long(S.reply, \"d2\", &d2)) S.sim_dist_mm[1] = (uint16_t)(d2 < 20 ? 20 : (d2 > 2000 ? 2000 : d2));\n      if (json_long(S.reply, \"d3\", &d3)) S.sim_dist_mm[2] = (uint16_t)(d3 < 20 ? 20 : (d3 > 2000 ? 2000 : d3));\n    }\n\n    double rate = vx_attr_read(S.attr_rate);\n    if (rate < 1.0) rate = 10.0;\n    if (rate > 100.0) rate = 100.0;\n    S.next_net_ns = now + (uint64_t)(1e9 / rate);\n    return;\n  }\n\n  if (now < S.next_net_ns) return;\n\n  int en0 = (vx_pin_read(S.units[0].pin_xshut) == VX_HIGH) ? 1 : 0;\n  int en1 = (vx_pin_read(S.units[1].pin_xshut) == VX_HIGH) ? 1 : 0;\n  int en2 = (vx_pin_read(S.units[2].pin_xshut) == VX_HIGH) ? 1 : 0;\n\n  char body[128];\n  snprintf(body, sizeof(body),\n           \"{\\\"v\\\":1,\\\"xshut\\\":[%d,%d,%d],\\\"t_ns\\\":%llu}\",\n           en0, en1, en2, (unsigned long long)now);\n\n  int32_t rc = vx_net_request(\"POST\", url_of(), \"text/plain\", body, (uint32_t)strlen(body));\n  if (rc == 0) {\n    S.req_in_flight = 1;\n  } else if (rc != VX_NET_BUSY) {\n    handle_net_error(now);\n  }\n}\n\nstatic void on_tick(void *user_data) {\n  (void)user_data;\n  step_network();\n  refresh_unit_distances();\n}\n\nstatic bool on_i2c_connect(void *user_data, uint8_t addr, bool is_read) {\n  (void)user_data;\n  (void)is_read;\n\n  refresh_unit_distances();\n\n  S.active_unit = -1;\n  for (int i = 0; i < 3; i++) {\n    if (vx_pin_read(S.units[i].pin_xshut) == VX_HIGH && S.units[i].i2c_addr == addr) {\n      S.active_unit = i;\n      break;\n    }\n  }\n\n  if (S.active_unit < 0) {\n    return false;\n  }\n\n  S.expect_reg_addr = 1;\n  return true;\n}\n\nstatic uint8_t on_i2c_read(void *user_data) {\n  (void)user_data;\n  if (S.active_unit < 0) {\n    return 0xFF;\n  }\n  vl53_unit_t *u = &S.units[S.active_unit];\n  uint8_t reg = S.reg_ptr;\n  uint8_t val = u->regs[reg];\n\n  if (reg == 0x83) {\n    val = 0x01;\n  } else if (reg == 0x92) {\n    val = 0x06;\n  } else if (reg == 0x91 && val == 0x00) {\n    val = 0x3C;\n  }\n\n  S.reg_ptr = (uint8_t)((S.reg_ptr + 1) & 0xFF);\n  return val;\n}\n\nstatic bool on_i2c_write(void *user_data, uint8_t byte) {\n  (void)user_data;\n  if (S.active_unit < 0) {\n    return false;\n  }\n  vl53_unit_t *u = &S.units[S.active_unit];\n\n  if (S.expect_reg_addr) {\n    S.reg_ptr = byte;\n    S.expect_reg_addr = 0;\n    return true;\n  }\n\n  uint8_t reg = S.reg_ptr;\n  u->regs[reg] = byte;\n\n  if (reg == 0xFF) {\n    u->page = byte;\n  }\n  if (reg == 0x8A) {\n    u->i2c_addr = byte & 0x7F;\n  }\n  if (reg == 0x83 && byte == 0x00) {\n    u->regs[0x83] = 0x01;\n  }\n  if (reg == 0x00) {\n    u->regs[0x00] = 0x00;\n    u->regs[0x13] = 0x07;\n    u->regs[0x14] = 0x00;\n  }\n  if (reg == 0x0B) {\n    u->regs[0x13] = 0x07;\n  }\n\n  S.reg_ptr = (uint8_t)((S.reg_ptr + 1) & 0xFF);\n  return true;\n}\n\nstatic void on_i2c_stop(void *user_data) {\n  (void)user_data;\n  S.active_unit = -1;\n}\n\nvoid chip_setup(void) {\n  memset(&S, 0, sizeof(S));\n  S.lfsr        = 0xACE12345U;\n  S.active_unit = -1;\n  S.backoff_ns  = MIN_BACKOFF_NS;\n\n  S.pin_vcc = vx_pin_register(\"VCC\", VX_INPUT_PULLUP);\n  S.pin_gnd = vx_pin_register(\"GND\", VX_INPUT_PULLDOWN);\n  S.pin_sda = vx_pin_register(\"SDA\", VX_INPUT_PULLUP);\n  S.pin_scl = vx_pin_register(\"SCL\", VX_INPUT_PULLUP);\n\n  S.units[0].pin_xshut = vx_pin_register(\"XSHUT1\", VX_INPUT_PULLUP);\n  S.units[1].pin_xshut = vx_pin_register(\"XSHUT2\", VX_INPUT_PULLUP);\n  S.units[2].pin_xshut = vx_pin_register(\"XSHUT3\", VX_INPUT_PULLUP);\n\n  for (int i = 0; i < 3; i++) {\n    reset_unit_registers(&S.units[i]);\n    S.units[i].phase_offset = (double)i * (TWO_PI_VAL / 3.0);\n    S.units[i].was_enabled  = 1;\n    S.sim_dist_mm[i]        = 800;\n  }\n\n  S.attr_freq_hz  = vx_attr_register(\"wave_freq_hz\", 0.5);\n  S.attr_noise_mm = vx_attr_register(\"noise_mm\",     5.0);\n  S.attr_url      = vx_attr_register_string(\"url\",   DEFAULT_URL);\n  S.attr_rate     = vx_attr_register(\"rate\",         10.0);\n\n  S.online      = (vx_net_available() != 0);\n  S.next_net_ns = TICK_PERIOD_NS;\n\n  const vx_i2c_config i2c_cfg = {\n    .address    = VL53L0X_DEFAULT_ADDR,\n    .scl        = S.pin_scl,\n    .sda        = S.pin_sda,\n    .on_connect = on_i2c_connect,\n    .on_read    = on_i2c_read,\n    .on_write   = on_i2c_write,\n    .on_stop    = on_i2c_stop,\n    .user_data  = &S,\n  };\n  vx_i2c_attach(&i2c_cfg);\n\n  S.sim_timer = vx_timer_create(on_tick, 0);\n  vx_timer_start(S.sim_timer, TICK_PERIOD_NS, true);\n\n  refresh_unit_distances();\n  vx_log(S.online ? \"3x VL53L0X ToF Array networked model ready on 0x29 (XSHUT1..3, 10 Hz net)\"\n                  : \"3x VL53L0X ToF Array offline model ready on 0x29 (XSHUT1..3)\");\n}\n",
        "chipJson": "{\n  \"schema\": \"velxio-chip/v1\",\n  \"name\": \"VL53L0X_3x_Array\",\n  \"author\": \"Custom\",\n  \"description\": \"3x VL53L0X ToF I2C Laser Ranging Array with XSHUT1..3 enable pins and 0.2m-0.8m sine-wave distance simulation.\",\n  \"pins\": [\n    { \"name\": \"VCC\", \"x\": 192, \"y\": 20 },\n    { \"name\": \"SDA\", \"x\": 192, \"y\": 33 },\n    { \"name\": \"SCL\", \"x\": 192, \"y\": 46 },\n    { \"name\": \"XSHUT1\", \"x\": 192, \"y\": 58 },\n    { \"name\": \"XSHUT2\", \"x\": 192, \"y\": 71 },\n    { \"name\": \"XSHUT3\", \"x\": 192, \"y\": 84 },\n    { \"name\": \"GND\", \"x\": 192, \"y\": 109 },\n    { \"name\": \"\", \"x\": 192, \"y\": 122 }\n  ],\n  \"attributes\": [\n    {\n      \"name\": \"wave_freq_hz\",\n      \"label\": \"Sine Wave Frequency (Hz)\",\n      \"type\": \"float\",\n      \"default\": 0.5,\n      \"min\": 0.1,\n      \"max\": 5.0,\n      \"step\": 0.1\n    },\n    {\n      \"name\": \"noise_mm\",\n      \"label\": \"Random Jitter Amplitude (mm)\",\n      \"type\": \"float\",\n      \"default\": 5.0,\n      \"min\": 0.0,\n      \"max\": 50.0,\n      \"step\": 1.0\n    },\n    {\n      \"name\": \"url\",\n      \"label\": \"Simulator URL\",\n      \"type\": \"string\",\n      \"default\": \"http://127.0.0.1:8765/api/tof\"\n    },\n    {\n      \"name\": \"rate\",\n      \"label\": \"Sim Polls / s\",\n      \"type\": \"int\",\n      \"default\": 10,\n      \"min\": 1,\n      \"max\": 100\n    }\n  ],\n  \"controls\": [\n    {\n      \"id\": \"wave_freq_hz\",\n      \"label\": \"Sine Wave Speed\",\n      \"type\": \"range\",\n      \"min\": 0.1,\n      \"max\": 5.0,\n      \"step\": 0.1,\n      \"unit\": \"Hz\"\n    },\n    {\n      \"id\": \"noise_mm\",\n      \"label\": \"Random Sensor Jitter\",\n      \"type\": \"range\",\n      \"min\": 0.0,\n      \"max\": 50.0,\n      \"step\": 1.0,\n      \"unit\": \"mm\"\n    }\n  ]\n}\n",
